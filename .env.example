# ==============================================================================
# LOCALCRICKET ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env and supply actual values for your deployment environment.
# ==============================================================================

# Server Runtime
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://user:password@localhost:5432/localcricket
DB_POOL_MAX=20

# Database TLS / SSL (MANDATORY IN PRODUCTION)
# Production requires DB_SSL=true and DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=/path/to/custom/ca-certificate.pem

# Authentication & Cryptographic Secrets
# JWT_SECRET must be at least 32 characters long and randomly generated in production
# Example generation command: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production!
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of authorized frontend origins. No wildcard (*) in production!
CORS_ORIGIN=https://localcricket.app

# Operational & Lifecycle Parameters
AUTO_MIGRATE=true
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_DISABLED=false
MIGRATION_LOCK_TIMEOUT_MS=15000
